#!/bin/bash

set -u

CUSTOM_HOOKS_DIR="/home/umbrel/umbrel/custom-hooks"
GLUETUN_SCRIPT="$CUSTOM_HOOKS_DIR/gluetun-daily-restart.sh"
GLUETUN_WATCHER_SCRIPT="$CUSTOM_HOOKS_DIR/gluetun-event-watcher.sh"
SMB_CREDENTIALS_FILE="/home/umbrel/umbrel/app-data/.smbcredentials"
STATUS_DIR="/home/umbrel/umbrel/app-data/status"
SERVICE_FILE="/etc/systemd/system/umbrel-gluetun-daily-restart.service"
TIMER_FILE="/etc/systemd/system/umbrel-gluetun-daily-restart.timer"
WATCHER_SERVICE_FILE="/etc/systemd/system/umbrel-gluetun-event-watcher.service"
APP_LOG_FILE="/home/umbrel/umbrel/app-data/martinmeel-hook-manager/logs/hook-manager.log"

SHARES=(
  "//192.168.2.168/Films|/home/umbrel/umbrel/home/Downloads/Films"
  "//192.168.2.168/Films2|/home/umbrel/umbrel/home/Downloads/Films2"
  "//192.168.2.168/TVSeries|/home/umbrel/umbrel/home/Downloads/TVSeries"
  "//192.168.2.168/TVSeriesOLD|/home/umbrel/umbrel/home/Downloads/TVSeriesOLD"
)

log() {
  mkdir -p "$(dirname "$APP_LOG_FILE")"
  printf '%s custom pre-start: %s\n' "$(date -Iseconds)" "$*" | tee -a "$APP_LOG_FILE"
}

credentials_ready() {
  [ -f "$SMB_CREDENTIALS_FILE" ] || return 1
  grep -q '^username=' "$SMB_CREDENTIALS_FILE" || return 1
  grep -q '^password=' "$SMB_CREDENTIALS_FILE" || return 1
  grep -q 'CHANGE_ME' "$SMB_CREDENTIALS_FILE" && return 1
  return 0
}

install_mc_if_missing() {
  if command -v mc >/dev/null 2>&1; then
    return 0
  fi

  if command -v apt-get >/dev/null 2>&1; then
    apt-get update
    if apt-get install -y mc; then
      log "installed mc successfully"
    else
      log "failed to install mc"
    fi
  else
    log "apt-get is not available, skipping mc installation"
  fi
}

ensure_credentials_file() {
  mkdir -p "$(dirname "$SMB_CREDENTIALS_FILE")"
  if [ ! -f "$SMB_CREDENTIALS_FILE" ]; then
    cat >"$SMB_CREDENTIALS_FILE" <<'EOF'
username=CHANGE_ME
password=CHANGE_ME
# domain=WORKGROUP
EOF
    chmod 600 "$SMB_CREDENTIALS_FILE"
    log "created $SMB_CREDENTIALS_FILE"
  fi
}

mount_share() {
  local remote="$1"
  local target="$2"

  mkdir -p "$target"

  if mountpoint -q "$target"; then
    log "$target is already mounted"
    return 0
  fi

  if ! credentials_ready; then
    log "credentials still contain CHANGE_ME, skipping mount for $remote"
    return 0
  fi

  if mount -t cifs "$remote" "$target" \
    -o "credentials=$SMB_CREDENTIALS_FILE,iocharset=utf8,uid=1000,gid=1000,file_mode=0664,dir_mode=0775,vers=3.0"; then
    log "mounted $remote on $target"
  else
    log "failed to mount $remote on $target"
  fi
}

install_systemd_units() {
  mkdir -p "$STATUS_DIR"

  cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Umbrel daily Gluetun restart
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$GLUETUN_SCRIPT
WorkingDirectory=/home/umbrel/umbrel
User=root
EOF

  cat >"$TIMER_FILE" <<'EOF'
[Unit]
Description=Run Umbrel daily Gluetun restart at 06:00

[Timer]
OnCalendar=*-*-* 06:00:00
Persistent=true

[Install]
WantedBy=timers.target
EOF

  cat >"$WATCHER_SERVICE_FILE" <<EOF
[Unit]
Description=Watch for manual Gluetun restarts and coordinate dependent Umbrel apps
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=$GLUETUN_WATCHER_SCRIPT
WorkingDirectory=/home/umbrel/umbrel
User=root
EOF

  systemctl daemon-reload
  systemctl enable --now umbrel-gluetun-daily-restart.timer
  systemctl enable --now umbrel-gluetun-event-watcher.service
  log "installed and enabled umbrel-gluetun-daily-restart.timer"
  log "installed and enabled umbrel-gluetun-event-watcher.service"
}

main() {
  log "starting managed pre-start"
  mkdir -p "$CUSTOM_HOOKS_DIR"
  ensure_credentials_file
  install_mc_if_missing

  local item
  local remote
  local target

  for item in "${SHARES[@]}"; do
    remote="${item%%|*}"
    target="${item##*|}"
    mount_share "$remote" "$target"
  done

  if [ -x "$GLUETUN_SCRIPT" ] && [ -x "$GLUETUN_WATCHER_SCRIPT" ]; then
    install_systemd_units
  else
    log "$GLUETUN_SCRIPT or $GLUETUN_WATCHER_SCRIPT is missing or not executable"
  fi

  log "managed pre-start completed"
}

main "$@"
